[Unit]
Description=nekonolock authentication helper
Documentation=https://github.com/nananek/nekonolock
Requires=nekonolock-auth.socket

[Service]
Type=simple
ExecStart=/usr/bin/nekonolock-auth
Restart=on-failure
RestartSec=1s
UMask=0077

# 認証ヘルパは Linux capability を必要としない。ユーザーセッションに
# ambient capability があっても継承しない。
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

# gpg-agent / scdaemon との Unix socket だけを使う。ネットワークは不要。
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=yes

# 書き込むのは gpg-agent 経由のカード操作だけで、OS のファイル階層は
# 読み取り専用にする。home は gpg が ~/.gnupg を読むため触らない。
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

# socket activation 専用。有効化するのは .socket だけで、.service は
# [Install] を持たない（systemd.socket の推奨構成）。
